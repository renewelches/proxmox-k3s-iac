# Copy this file to all.yml and fill in your environment-specific values.
# all.yml is gitignored (like terraform.tfvars) so your real values stay private.

# --- MetalLB (deploy-metallb.yml) --------------------------------------------
# Address pool MetalLB hands out to Service type=LoadBalancer. Required.
# Use ranges and/or CIDRs that are free in your network and NOT in any DHCP scope.
metallb_pool_addresses:
  - "192.168.1.240-192.168.1.250"

# Optional knobs (defaults shown):
# metallb_pool_name: default-pool
# metallb_version: v0.14.9
# k3s_disable_servicelb: true   # set false to keep k3s' bundled ServiceLB (Klipper)

# --- Private registry (deploy-k3s.yml) ---------------------------------------
# Optional. Define k3s_registry_host to render /etc/rancher/k3s/registries.yaml
# on every node so containerd can pull from a private registry. Omit the whole
# block to skip it.
#
# Example: GCP Artifact Registry authenticated with a service-account key.json.
# k3s_registry_host is the registry endpoint (region-specific for Artifact
# Registry, e.g. europe-west1-docker.pkg.dev; gcr.io for legacy GCR).
# k3s_registry_key_file is a path on the Ansible control machine to the
# key.json; its contents are embedded at render time (kept out of this repo).
#
# k3s_registry_host: europe-west1-docker.pkg.dev
# k3s_registry_key_file: /Users/rene/Documents/Workspace/hello-world/key.json
# k3s_registry_username: _json_key_base64   # default; rarely needs changing
