# Copy this file to all.yml and fill in your environment-specific values.
# all.yml is gitignored (like terraform.tfvars) so your real values stay private.

# --- MetalLB (deploy-metallb.yml) --------------------------------------------
# Address pool MetalLB hands out to Service type=LoadBalancer. Required.
# Use ranges and/or CIDRs that are free in your network and NOT in any DHCP scope.
metallb_pool_addresses:
  - "192.168.1.240-192.168.1.250"

# Optional knobs (defaults shown):
# metallb_pool_name: default-pool
# metallb_version: v0.14.9
# k3s_disable_servicelb: true   # set false to keep k3s' bundled ServiceLB (Klipper)
